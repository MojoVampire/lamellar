.PRECIOUS: Makefile


@TL_CUDA_ENABLED_TRUE@all-local: $(local_la_modules)

# Create symbolic links for the built modules under $(localmoduledir)
# Link also *.la files to create proper makefile dependencies
@TL_CUDA_ENABLED_TRUE@$(local_la_modules): $(module_LTLIBRARIES)
@TL_CUDA_ENABLED_TRUE@	$(AM_V_at)$(MKDIR_P) $(localmoduledir)
@TL_CUDA_ENABLED_TRUE@	$(AM_V_at)$(MKDIR_P) $(abs_top_builddir)/src/.libs
@TL_CUDA_ENABLED_TRUE@	$(AM_V_at)$(LN_S) -f $(localmoduledir) $(abs_top_builddir)/src/.libs/$(modulesubdir)
@TL_CUDA_ENABLED_TRUE@	$(AM_V_at)for lib in *.la $(objdir)/*$(shrext)*; do \
@TL_CUDA_ENABLED_TRUE@		(cd $(localmoduledir) && $(LN_RS) -nf $(shell pwd)/$$lib); \
@TL_CUDA_ENABLED_TRUE@	done
@TL_CUDA_ENABLED_TRUE@	@for lib in *.la $(objdir)/*$(shrext)*; do \
@TL_CUDA_ENABLED_TRUE@		$(AM_V_LN) $$lib; \
@TL_CUDA_ENABLED_TRUE@	done

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:
