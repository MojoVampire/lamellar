@TL_CUDA_ENABLED_TRUE@	allgather/allgather.c        \
@TL_CUDA_ENABLED_TRUE@	allgather/allgather_ring.c   \
@TL_CUDA_ENABLED_TRUE@	allgather/allgather_linear.c

@TL_CUDA_ENABLED_TRUE@allgatherv = allgatherv/allgatherv.h \
@TL_CUDA_ENABLED_TRUE@	allgatherv/allgatherv.c \
@TL_CUDA_ENABLED_TRUE@	allgatherv/allgatherv_ring.c \
@TL_CUDA_ENABLED_TRUE@	allgatherv/allgatherv_linear.c \
@TL_CUDA_ENABLED_TRUE@	$(am__append_4)
@TL_CUDA_ENABLED_TRUE@alltoall = \
@TL_CUDA_ENABLED_TRUE@	alltoall/alltoall.h    \
@TL_CUDA_ENABLED_TRUE@	alltoall/alltoall.c    \
@TL_CUDA_ENABLED_TRUE@	alltoall/alltoall_ce.c

@TL_CUDA_ENABLED_TRUE@alltoallv = \
@TL_CUDA_ENABLED_TRUE@	alltoallv/alltoallv.h    \
@TL_CUDA_ENABLED_TRUE@	alltoallv/alltoallv.c    \
@TL_CUDA_ENABLED_TRUE@	alltoallv/alltoallv_ce.c

@TL_CUDA_ENABLED_TRUE@bcast = \
@TL_CUDA_ENABLED_TRUE@	bcast/bcast.h        \
@TL_CUDA_ENABLED_TRUE@	bcast/bcast.c        \
@TL_CUDA_ENABLED_TRUE@	bcast/bcast_linear.c

@TL_CUDA_ENABLED_TRUE@reduce_scatter =  \
@TL_CUDA_ENABLED_TRUE@	reduce_scatter/reduce_scatter.h \
@TL_CUDA_ENABLED_TRUE@	reduce_scatter/reduce_scatter.c \
@TL_CUDA_ENABLED_TRUE@	reduce_scatter/reduce_scatter_ring.c \
@TL_CUDA_ENABLED_TRUE@	reduce_scatter/reduce_scatter_linear.c \
@TL_CUDA_ENABLED_TRUE@	$(am__append_1)
@TL_CUDA_ENABLED_TRUE@reduce_scatterv =  \
@TL_CUDA_ENABLED_TRUE@	reduce_scatterv/reduce_scatterv.h \
@TL_CUDA_ENABLED_TRUE@	reduce_scatterv/reduce_scatterv.c \
@TL_CUDA_ENABLED_TRUE@	reduce_scatterv/reduce_scatterv_ring.c \
@TL_CUDA_ENABLED_TRUE@	reduce_scatterv/reduce_scatterv_linear.c \
@TL_CUDA_ENABLED_TRUE@	$(am__append_2)
@TL_CUDA_ENABLED_TRUE@allreduce = allreduce/allreduce.h \
@TL_CUDA_ENABLED_TRUE@	allreduce/allreduce.c $(am__append_3)
@TL_CUDA_ENABLED_TRUE@sources = tl_cuda.h tl_cuda.c tl_cuda_lib.c \
@TL_CUDA_ENABLED_TRUE@	tl_cuda_context.c tl_cuda_team.c \
@TL_CUDA_ENABLED_TRUE@	tl_cuda_coll.c tl_cuda_cache.c \
@TL_CUDA_ENABLED_TRUE@	tl_cuda_topo.c tl_cuda_team_topo.c \
@TL_CUDA_ENABLED_TRUE@	$(allgather) $(allgatherv) $(alltoall) \
@TL_CUDA_ENABLED_TRUE@	$(alltoallv) $(bcast) $(allreduce) \
@TL_CUDA_ENABLED_TRUE@	$(reduce_scatter) $(reduce_scatterv) \
@TL_CUDA_ENABLED_TRUE@	$(am__append_5)
@TL_CUDA_ENABLED_TRUE@module_LTLIBRARIES = libucc_tl_cuda.la
@TL_CUDA_ENABLED_TRUE@libucc_tl_cuda_la_SOURCES = $(sources)
@TL_CUDA_ENABLED_TRUE@libucc_tl_cuda_la_CPPFLAGS = $(AM_CPPFLAGS) $(BASE_CPPFLAGS) $(CUDA_CPPFLAGS)
@TL_CUDA_ENABLED_TRUE@libucc_tl_cuda_la_CFLAGS = $(BASE_CFLAGS)
@TL_CUDA_ENABLED_TRUE@libucc_tl_cuda_la_LDFLAGS = -version-info $(SOVERSION) --as-needed $(CUDA_LDFLAGS) -lstdc++
@TL_CUDA_ENABLED_TRUE@libucc_tl_cuda_la_LIBADD = $(CUDA_LIBS) $(NVML_LIBS) $(UCC_TOP_BUILDDIR)/src/libucc.la kernels/libucc_tl_cuda_kernels.la

# Automake silent rules
@TL_CUDA_ENABLED_TRUE@AM_V_LN = $(AM_V_LN_@AM_V@)
@TL_CUDA_ENABLED_TRUE@AM_V_LN_ = $(AM_V_LN_@AM_DEFAULT_V@)
@TL_CUDA_ENABLED_TRUE@AM_V_LN_0 = echo "  LN      "
@TL_CUDA_ENABLED_TRUE@AM_V_LN_1 = true
@TL_CUDA_ENABLED_TRUE@local_la_modules = $(patsubst %, $(localmoduledir)/%, $(module_LTLIBRARIES))
all: all-recursive

.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am $(top_srcdir)/config/module.am $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign src/components/tl/cuda/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign src/components/tl/cuda/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/config/module.am $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

install-moduleLTLIBRARIES: $(module_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(module_LTLIBRARIES)'; test -n "$(moduledir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(moduledir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(moduledir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(moduledir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(moduledir)"; \
	}

uninstall-moduleLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(module_LTLIBRARIES)'; test -n "$(moduledir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(moduledir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(moduledir)/$$f"; \
	done

clean-moduleLTLIBRARIES:
	-test -z "$(module_LTLIBRARIES)" || rm -f $(module_LTLIBRARIES)
	@list='$(module_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}
