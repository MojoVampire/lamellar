	-rm -f alltoallv/*.lo
	-rm -f barrier/*.$(OBJEXT)
	-rm -f barrier/*.lo
	-rm -f bcast/*.$(OBJEXT)
	-rm -f bcast/*.lo
	-rm -f reduce/*.$(OBJEXT)
	-rm -f reduce/*.lo

distclean-compile:
	-rm -f *.tab.c

