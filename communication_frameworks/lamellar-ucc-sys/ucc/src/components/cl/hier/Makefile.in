reduce/$(am__dirstamp):
	@$(MKDIR_P) reduce
	@: > reduce/$(am__dirstamp)
reduce/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) reduce/$(DEPDIR)
