	@$(MKDIR_P) allgatherv
	@: > allgatherv/$(am__dirstamp)
allgatherv/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) allgatherv/$(DEPDIR)
	@: > allgatherv/$(DEPDIR)/$(am__dirstamp)
allgatherv/libucc_cl_hier_la-unpack.lo: allgatherv/$(am__dirstamp) \
	allgatherv/$(DEPDIR)/$(am__dirstamp)
allgatherv/libucc_cl_hier_la-allgatherv.lo:  \
	allgatherv/$(am__dirstamp) \
