libucc_cl_hier.la: $(libucc_cl_hier_la_OBJECTS) $(libucc_cl_hier_la_DEPENDENCIES) $(EXTRA_libucc_cl_hier_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libucc_cl_hier_la_LINK) -rpath $(moduledir) $(libucc_cl_hier_la_OBJECTS) $(libucc_cl_hier_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)
	-rm -f allgatherv/*.$(OBJEXT)
	-rm -f allgatherv/*.lo
	-rm -f allreduce/*.$(OBJEXT)
	-rm -f allreduce/*.lo
	-rm -f alltoall/*.$(OBJEXT)
