components/topo/$(am__dirstamp):
	@$(MKDIR_P) components/topo
	@: > components/topo/$(am__dirstamp)
components/topo/$(DEPDIR)/$(am__dirstamp):
	@$(MKDIR_P) components/topo/$(DEPDIR)
	@: > components/topo/$(DEPDIR)/$(am__dirstamp)
components/topo/libucc_la-ucc_topo.lo:  \
	components/topo/$(am__dirstamp) \
	components/topo/$(DEPDIR)/$(am__dirstamp)
components/topo/libucc_la-ucc_sysinfo.lo:  \
	components/topo/$(am__dirstamp) \
	components/topo/$(DEPDIR)/$(am__dirstamp)
components/topo/libucc_la-ucc_sbgp.lo:  \
	components/topo/$(am__dirstamp) \
	components/topo/$(DEPDIR)/$(am__dirstamp)

libucc.la: $(libucc_la_OBJECTS) $(libucc_la_DEPENDENCIES) $(EXTRA_libucc_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libucc_la_LINK) -rpath $(libdir) $(libucc_la_OBJECTS) $(libucc_la_LIBADD) $(LIBS)

