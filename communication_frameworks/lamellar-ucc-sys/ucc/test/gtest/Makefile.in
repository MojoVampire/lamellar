@HAVE_GTEST_TRUE@	$(am__append_11) $(am__append_15)
@HAVE_GTEST_TRUE@gtest_CPPFLAGS = $(BASE_CPPFLAGS) -I$(top_srcdir)/src \
@HAVE_GTEST_TRUE@	-I$(top_srcdir)/test -I$(top_builddir)/src \
